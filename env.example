# ═══════════════════════════════════════════════════════════════════
#  VEELEAD HELPDESK RAG BOT — Environment Configuration
# ═══════════════════════════════════════════════════════════════════
#  This is the TEMPLATE file. Copy it to `.env` and fill in real values.
#
#  USAGE:
#    1. Copy this file:        cp .env.example .env
#    2. Edit .env and fill in real values for each section.
#    3. NEVER commit .env to git (it's in .gitignore).
#    4. For Azure App Service: paste each KEY=VALUE pair under
#       App Service → Environment Variables → App Settings.
#
#  STATUS LEGEND:
#    [READY]    — You can fill this in NOW
#    [PENDING]  — Waiting on Azure setup or IT admin
#    [OPTIONAL] — Use defaults unless you have a reason to change
# ═══════════════════════════════════════════════════════════════════


# ───────────────────────────────────────────────────────────────────
# 1. SOURCE MODE
# ───────────────────────────────────────────────────────────────────
# Where the bot reads documents from.
#   local      → reads PDFs/DOCXs/HTMLs from LOCAL_DATA_FOLDER (testing)
#   sharepoint → reads from SharePoint via Microsoft Graph API (production)
#
# [READY] — Start with `local` for testing, switch to `sharepoint` later.
SOURCE_TYPE=local

# Path to local folder (used only when SOURCE_TYPE=local)
LOCAL_DATA_FOLDER=./local_data


# ───────────────────────────────────────────────────────────────────
# 2. SHAREPOINT / MICROSOFT GRAPH
# ───────────────────────────────────────────────────────────────────
# These come from the Azure AD App Registration your IT admin creates.
# Required only when SOURCE_TYPE=sharepoint.
#
# [PENDING] — Waiting on IT admin (see admin email template)
# Likely tenant ID from your SharePoint URL: dada034a-421f-40dd-90b4-98e44386f293

TENANT_ID=dada034a-421f-40dd-90b4-98e44386f293
CLIENT_ID=<from-admin-after-app-registration>
CLIENT_SECRET=<from-admin-after-app-registration>

# SharePoint location to read from
SHAREPOINT_SITE_URL=https://veeleaddev.sharepoint.com/sites/Helpdesk
SHAREPOINT_LIBRARY=HD_KnowledgeDocuments


# ───────────────────────────────────────────────────────────────────
# 3. AZURE OPENAI — EMBEDDING MODEL
# ───────────────────────────────────────────────────────────────────
# Used to convert document chunks and user queries into vectors.
# Resource: policyveelead123
#
# [READY] — You have this. Get values from:
#   Azure Portal → Azure OpenAI → policyveelead123 → "Keys and Endpoint"
#
# ⚠️ IMPORTANT: Regenerate Key 1 first! The old key was exposed earlier.

EMBED_ENDPOINT=https://policyveelead123.openai.azure.com/
EMBED_API_KEY=<paste-newly-regenerated-key-here>
EMBED_DEPLOYMENT=text-embedding-3-small
EMBED_API_VER=2024-12-01-preview


# ───────────────────────────────────────────────────────────────────
# 4. AZURE OPENAI — CHAT MODELS (mini + large)
# ───────────────────────────────────────────────────────────────────
# Two deployments used:
#   gpt-4o-mini → 80% of queries (cheap, fast)
#   gpt-4o      → complex queries (20%)
# Resource: sharepointbot
#
# [READY] — You have this. Get values from:
#   Azure Portal → Azure OpenAI → sharepointbot → "Keys and Endpoint"
#
# ⚠️ IMPORTANT: Regenerate Key 1 first! The old key was exposed earlier.
# ⚠️ Confirm both deployments exist: Foundry → Deployments tab.

GPT_ENDPOINT=https://sharepointbot.openai.azure.com/
GPT_API_KEY=<paste-newly-regenerated-key-here>
GPT_MINI_DEPLOY=gpt-4o-mini
GPT_LARGE_DEPLOY=gpt-4o
GPT_API_VER=2024-12-01-preview


# ───────────────────────────────────────────────────────────────────
# 5. AZURE AI SEARCH (vector + keyword index)
# ───────────────────────────────────────────────────────────────────
# Stores document chunks and embeddings. Free tier for now.
#
# [PENDING] — Create the service first (Step 3 of setup guide).
# Get values from:
#   Azure Portal → Azure AI Search → your service → "Keys" + overview page

SEARCH_ENDPOINT=https://veelead-helpdesk-search.search.windows.net
SEARCH_API_KEY=<from-azure-portal-after-creating-search-service>
SEARCH_INDEX=veelead-docs


# ───────────────────────────────────────────────────────────────────
# 6. API AUTHENTICATION
# ───────────────────────────────────────────────────────────────────
# Frontend must send this in `x-api-key` header on every request.
# Prevents random people from spamming the bot.
#
# [READY] — Generate a strong random string:
#   PowerShell:  -join ((48..57) + (97..122) | Get-Random -Count 48 | %{[char]$_})
#   Linux/Mac:   openssl rand -hex 32
#   Or use any password generator (32+ characters)

API_KEY=change-me-generate-a-random-32-char-string-now


# ───────────────────────────────────────────────────────────────────
# 7. RAG TUNING (defaults are good — change only if needed)
# ───────────────────────────────────────────────────────────────────
# [OPTIONAL]

# Chunk size in words (smaller = more precise, more chunks; bigger = more context)
CHUNK_SIZE=400
CHUNK_OVERLAP=60

# How many chunks to retrieve and send to the LLM
TOP_K_RETRIEVE=10
TOP_K_USE=4

# Cache TTL — how long to cache an answer (hours)
CACHE_TTL_HOURS=168

# Semantic cache match threshold — cosine similarity score (0.0 to 1.0) above
# which a NEW question reuses a CACHED answer from a related earlier question.
# 0.92 is the recommended default. Tune cautiously:
#   0.95  Very strict — almost only exact wording matches
#   0.92  Strict — same question phrased differently  (RECOMMENDED)
#   0.88  Medium — small chance of returning wrong answers
#   0.85  Loose — real risk of returning wrong answers
CACHE_SEMANTIC_THRESHOLD=0.92

# Auto-sync frequency — how often to check SharePoint for new/changed files (minutes)
# Only used when SOURCE_TYPE=sharepoint
SYNC_INTERVAL_MINUTES=60


# ───────────────────────────────────────────────────────────────────
# 8. STORAGE (where SQLite files live)
# ───────────────────────────────────────────────────────────────────
# [OPTIONAL]
# Local dev:        ./data
# Azure App Service: /home/data  (persists across restarts)

DATA_DIR=./data


# ───────────────────────────────────────────────────────────────────
# 9. LOGGING
# ───────────────────────────────────────────────────────────────────
# [OPTIONAL]
# DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO


# ═══════════════════════════════════════════════════════════════════
#  CHECKLIST BEFORE RUNNING
# ═══════════════════════════════════════════════════════════════════
#  [ ] Copied .env.example to .env
#  [ ] Filled in EMBED_API_KEY (after regenerating in Azure Portal)
#  [ ] Filled in GPT_API_KEY (after regenerating in Azure Portal)
#  [ ] Created Azure AI Search service (Free tier)
#  [ ] Filled in SEARCH_ENDPOINT + SEARCH_API_KEY
#  [ ] Generated a strong API_KEY (32+ random chars)
#  [ ] Confirmed text-embedding-3-small is deployed in Azure OpenAI
#  [ ] Confirmed gpt-4o-mini is deployed in Azure OpenAI
#  [ ] Confirmed gpt-4o is deployed in Azure OpenAI
#  [ ] (Later) Filled in CLIENT_ID + CLIENT_SECRET from IT admin
# ═══════════════════════════════════════════════════════════════════
